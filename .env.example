# Local development settings. Copy to .env: cp .env.example .env
# These values are local-only placeholders for a database on 127.0.0.1, not secrets.

# Postgres (Docker Compose, localhost only)
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
POSTGRES_PORT=5433
# Built from the values above (bash, Compose and the API's dotenv loader all expand ${…}).
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# API (always binds 127.0.0.1)
WAYPOINT_API_PORT=8000

# Claude CLI (model calls run `claude -p` with your subscription login, never an API key)
# WAYPOINT_CLAUDE_BIN=claude
# WAYPOINT_CLAUDE_TIMEOUT_SECS=300

# Job queue (jobs running at once; how long the queue pauses after a usage limit)
# WAYPOINT_JOB_CONCURRENCY=2
# WAYPOINT_JOB_USAGE_LIMIT_PAUSE_SECS=900

# Web dev server
WAYPOINT_WEB_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
