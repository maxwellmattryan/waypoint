      "name": "rejection-company-and-role",
      "setup": {
        "applications": [{"name": "vandelay", "company": "Vandelay Industries", "title": "Senior Engineer", "status": "applied"}],
        "emails": [{"file": "emails/ashby-rejection.eml", "classification": {"class": "rejection", "confidence": 0.95, "company": "Vandelay Industries", "role": "Senior Engineer"}}]
      },
      "input": {"classification_id": "${classification_id}"},
      "expect": {
        "status": "succeeded",
        "output": {"status": "applied", "application_id": "${application_vandelay}", "ops": [{"op": "set_status", "from": "applied", "to": "rejected"}]},
        "actions": [{"tool": "set_application_status", "undone": false}],
        "review_items": []
      }
    },
    {
      "name": "ats-sender-name-and-role",
      "setup": {
        "applications": [{"name": "hooli", "company": "Hooli", "title": "Backend Engineer", "status": "applied"}],
