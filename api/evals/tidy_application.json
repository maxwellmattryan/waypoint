{
  "workflow": "tidy_application",
  "cases": [
    {
      "name": "confident note is applied",
      "setup": {"application": {"company": "Acme", "title": "Engineer"}},
      "input": {"application_id": "${application_id}", "note": "Called the recruiter", "message": "Thanks", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "actions": [{"tool": "add_note", "undone": false}],
        "review_items": [],
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Thanks"}}
        ],
        "memories": []
      }
    },
    {
      "name": "threshold confidence is applied",
      "setup": {"application": {"company": "Globex", "title": "Staff Engineer", "status": "applied"}},
      "input": {"application_id": "${application_id}", "note": "Sent the take-home", "message": "Looking forward to it", "confidence": 0.8},
      "expect": {
        "status": "awaiting_approval",
        "actions": [{"tool": "add_note", "undone": false}],
        "review_items": [],
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Looking forward to it"}}
        ],
        "memories": []
      }
    },
    {
      "name": "just below threshold goes to review",
      "setup": {"application": {"company": "Initech", "title": "Backend Engineer"}},
      "input": {"application_id": "${application_id}", "note": "Maybe a second round", "message": "Any update?", "confidence": 0.79},
      "expect": {
        "status": "awaiting_approval",
        "actions": [],
        "review_items": [
          {"kind": "tidy.note", "confidence": 0.79, "payload": {"application_id": "${application_id}", "note": "Maybe a second round"}}
        ],
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Any update?"}}
        ],
        "memories": []
      }
    },
    {
      "name": "low confidence goes to review",
      "setup": {"application": {"company": "Umbrella", "title": "Platform Engineer", "status": "interviewing"}},
      "input": {"application_id": "${application_id}", "note": "Recruiter might have ghosted", "message": "Checking in", "confidence": 0.2},
      "expect": {
        "status": "awaiting_approval",
        "actions": [],
        "review_items": [
          {"kind": "tidy.note", "confidence": 0.2, "payload": {"application_id": "${application_id}", "note": "Recruiter might have ghosted"}}
        ],
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Checking in"}}
        ],
        "memories": []
      }
    },
    {
      "name": "unknown application fails",
      "input": {"application_id": 999999999, "note": "Nobody home", "message": "Hello?", "confidence": 0.9},
      "expect": {
        "status": "failed",
        "error_contains": "doesn't exist",
        "actions": [],
        "pending_actions": [],
        "memories": []
      }
    },
    {
      "name": "missing confidence fails",
      "setup": {"application": {"company": "Hooli", "title": "Engineer"}},
      "input": {"application_id": "${application_id}", "note": "No confidence given", "message": "Thanks"},
      "expect": {
        "status": "failed",
        "error_contains": "confidence",
        "actions": [],
        "memories": []
      }
    },
    {
      "name": "recall: relevant memory retrieved, unrelated excluded",
      "setup": {
        "application": {"company": "Pied Piper", "title": "Compression Engineer"},
        "memories": [
          {"name": "relevant", "kind": "fact", "topic": "other", "content": "Pied Piper's team uses middle-out compression"},
          {"name": "unrelated", "kind": "fact", "topic": "other", "content": "Enjoys sourdough baking"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Met the team", "message": "Thanks for the chat", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": [{"step": "draft", "memory_id": "${memory_relevant}"}]
      }
    },
    {
      "name": "recall: proposed memory excluded",
      "setup": {
        "application": {"company": "Hooli", "title": "Product Engineer"},
        "memories": [
          {"name": "proposed", "kind": "fact", "topic": "other", "content": "Hooli product engineer, following up", "status": "proposed"},
          {"name": "confirmed", "kind": "fact", "topic": "other", "content": "Hooli interviews happen on Tuesdays"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Waiting on Hooli", "message": "Following up", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": [{"step": "draft", "memory_id": "${memory_confirmed}"}]
      }
    },
    {
      "name": "recall: more shared terms rank first",
      "setup": {
        "application": {"company": "Initech", "title": "Backend Engineer"},
        "memories": [
          {"name": "both", "kind": "fact", "topic": "other", "content": "Initech's backend team writes Go"},
          {"name": "one", "kind": "fact", "topic": "other", "content": "Initech is in Austin"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Second round booked", "message": "Any news?", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": [
          {"step": "draft", "memory_id": "${memory_both}"},
          {"step": "draft", "memory_id": "${memory_one}"}
        ]
      }
    },
    {
      "name": "recall: a tag matching the company",
      "setup": {
        "application": {"company": "Umbrella", "title": "Platform Engineer"},
        "memories": [
          {"name": "tagged", "kind": "preference", "topic": "location", "content": "Prefers hybrid work", "tags": ["Umbrella"]}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Recruiter call done", "message": "Checking in", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": [{"step": "draft", "memory_id": "${memory_tagged}"}]
      }
    },
    {
      "name": "recall: no shared term retrieves nothing",
      "setup": {
        "application": {"company": "Globex", "title": "Staff Engineer"},
        "memories": [
          {"name": "baking", "kind": "fact", "topic": "other", "content": "Enjoys sourdough baking"},
          {"name": "language", "kind": "fact", "topic": "skill", "content": "Speaks Portuguese"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Applied", "message": "Looking forward to it", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": []
      }
    },
    {
      "name": "recall: at most five memories",
      "setup": {
        "application": {"company": "Vandelay", "title": "Import Engineer"},
        "memories": [
          {"name": "m1", "kind": "fact", "topic": "other", "content": "Vandelay detail 1"},
          {"name": "m2", "kind": "fact", "topic": "other", "content": "Vandelay detail 2"},
          {"name": "m3", "kind": "fact", "topic": "other", "content": "Vandelay detail 3"},
          {"name": "m4", "kind": "fact", "topic": "other", "content": "Vandelay detail 4"},
          {"name": "m5", "kind": "fact", "topic": "other", "content": "Vandelay detail 5"},
          {"name": "m6", "kind": "fact", "topic": "other", "content": "Vandelay detail 6"},
          {"name": "m7", "kind": "fact", "topic": "other", "content": "Vandelay detail 7"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Applied", "message": "Hello", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "memories": [
          {"step": "draft", "memory_id": "${memory_m7}"},
          {"step": "draft", "memory_id": "${memory_m6}"},
          {"step": "draft", "memory_id": "${memory_m5}"},
          {"step": "draft", "memory_id": "${memory_m4}"},
          {"step": "draft", "memory_id": "${memory_m3}"}
        ]
      }
    },
    {
      "name": "draft: confirmed preference changes the draft, fact doesn't",
      "setup": {
        "application": {"company": "Stark", "title": "Rust Engineer"},
        "memories": [
          {"name": "pref", "kind": "preference", "topic": "location", "content": "Stark Rust roles: remote only"},
          {"name": "fact", "kind": "fact", "topic": "other", "content": "Stark is in Malibu"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Applied", "message": "Following up", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Following up\n\nStark Rust roles: remote only"}}
        ],
        "memories": [
          {"step": "draft", "memory_id": "${memory_pref}"},
          {"step": "draft", "memory_id": "${memory_fact}"}
        ]
      }
    },
    {
      "name": "draft: proposed memory leaves the draft unchanged",
      "setup": {
        "application": {"company": "Wayne", "title": "Data Engineer"},
        "memories": [
          {"name": "proposed", "kind": "preference", "topic": "location", "content": "Wayne data roles: remote only", "status": "proposed"}
        ]
      },
      "input": {"application_id": "${application_id}", "note": "Applied", "message": "Checking in", "confidence": 0.9},
      "expect": {
        "status": "awaiting_approval",
        "pending_actions": [
          {"tool": "draft_follow_up", "status": "pending", "input": {"application_id": "${application_id}", "message": "Checking in"}}
        ],
        "memories": []
      }
    }
  ]
}
